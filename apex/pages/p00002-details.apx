page 2 (
    name: Package Details
    alias: DETAILS
    title: Package Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region functions (
        name: Functions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    json_value(func, '$.name') as func_name,
                    json_value(func, '$.description') as func_desc,
                    json_value(func, '$.return_type') as return_type
                FROM 
                    ocd.ocd_apex_package_docs,
                    JSON_TABLE(pkg_data, '$.functions[*]' COLUMNS (func PATH '$'))
                WHERE object_name = :P2_PACKAGE_NAME
                ```
            pageItemsToSubmit: P2_PACKAGE_NAME
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 13561983485667116
        }

        column FUNC_DESC (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column FUNC_NAME (
            type: plainText
            heading {
                heading: Function Name
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column RETURN_TYPE (
            type: plainText
            heading {
                heading: Return Type
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FUNC_DESC (
                sequence: 2
            )

            displayColumn FUNC_NAME (
                sequence: 1
            )

            displayColumn RETURN_TYPE (
                sequence: 3
            )

        )

    )

    region json-source (
        name: JSON_SOURCE
        title: JSON Source
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    v_content clob;
                begin
                    select 
                        '<pre style="white-space:pre-wrap;font-family:monospace;">'
                        || apex_escape.html(json_serialize(pkg_data pretty))
                        || '</pre>'
                    into v_content
                    from ocd.ocd_apex_package_docs
                    where object_name = :P2_PACKAGE_NAME;
                
                    return v_content;
                end;
                ```
            pageItemsToSubmit: P2_PACKAGE_NAME
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region package-info (
        name: PACKAGE_INFO
        title: Package Information
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    v_content clob;
                begin
                    SELECT 
                        '<h3>' || json_value(pkg_data, '$.name') || '</h3>' 
                        ||'<p>' || json_value(pkg_data, '$.description') || '</p>' c
                    into v_content
                    FROM ocd.ocd_apex_package_docs
                    WHERE object_name = :P2_PACKAGE_NAME;
                
                    return v_content;
                end;
                ```
            pageItemsToSubmit: P2_PACKAGE_NAME
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region procedures (
        name: Procedures
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    json_value(proc, '$.name') as proc_name,
                    json_value(proc, '$.description') as proc_desc
                FROM
                    ocd.ocd_apex_package_docs,
                    JSON_TABLE(pkg_data, '$.procedures[*]' COLUMNS (proc PATH '$'))
                WHERE object_name = :P2_PACKAGE_NAME
                ```
            pageItemsToSubmit: P2_PACKAGE_NAME
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 13562433278667121
        }

        column PROC_DESC (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PROC_NAME (
            type: plainText
            heading {
                heading: Procedure Name
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PROC_DESC (
                sequence: 2
            )

            displayColumn PROC_NAME (
                sequence: 1
            )

        )

    )

    pageItem P2_PACKAGE_NAME (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )

    button new (
        buttonName: New
        label: New
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @functions
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @functions
            }
            execution {
                sequence: 10
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @procedures
            }
            execution {
                sequence: 20
            }
        )

        action native-refresh_1_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @package-info
            }
            execution {
                sequence: 30
            }
        )

    )

    process validate-package_1 (
        name: VALIDATE_PACKAGE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_cnt PLS_INTEGER;
                BEGIN
                    SELECT COUNT(*) INTO l_cnt
                    FROM ocd_apex_package_docs
                    WHERE object_name = :P2_PACKAGE_NAME;
                
                    IF l_cnt = 0 THEN
                        apex_util.redirect_url(
                            apex_page.get_url(
                                p_page   => 3,
                                p_items  => 'P3_PACKAGE_NAME',
                                p_values => :P2_PACKAGE_NAME));
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13562946435667126
        }
    )

)

