page 3 (
    name: Error
    alias: ERROR
    title: Error
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: Package not found
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Package "<strong>&P3_SCHEMA_NAME..&P3_PACKAGE_NAME.</strong>" not found or not documented.</p>
                        
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P3_PACKAGE_NAME (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P3_SCHEMA_NAME (
        type: hidden
        layout {
            sequence: 5
            slot: body
        }
    )

    button back (
        buttonName: BACK
        label: Back to Package List
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )

)

