page 2 (
    name: Package Details
    alias: DETAILS
    title: Package Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript
            // Copy buttons of the code blocks rendered by ocd_apex_util.package_html.
            document.addEventListener('click', function (event) {
              var button = event.target.closest('.ocd-copy');
              if (!button) {
                return;
              }
              var code = button.closest('.ocd-code').querySelector('code').textContent;
              var icon = button.querySelector('.fa');
              var label = button.querySelector('.ocd-copy-label');
              navigator.clipboard.writeText(code).then(function () {
                icon.classList.replace('fa-copy', 'fa-check');
                label.textContent = 'Copied';
                setTimeout(function () {
                  icon.classList.replace('fa-check', 'fa-copy');
                  label.textContent = 'Copy';
                }, 2000);
              });
            });
            ```
    }
    css {
        inline:
            ```css
            .ocd-doc h2 {
              margin: 2rem 0 .5rem;
              font-size: 1.25rem;
            }
            .ocd-doc h3 {
              margin: 1.25rem 0 .5rem;
              font-size: 1rem;
            }
            .ocd-doc [id^="ocd-"] {
              scroll-margin-top: 5rem;
            }
            .ocd-doc .ocd-code {
              margin: 1rem 0;
              border: 1px solid rgba(0, 0, 0, .12);
              border-radius: .25rem;
              background: rgba(0, 0, 0, .04);
            }
            .ocd-doc .ocd-code-bar {
              display: flex;
              align-items: center;
              justify-content: space-between;
              border-bottom: 1px solid rgba(0, 0, 0, .12);
            }
            .ocd-doc .ocd-code-title {
              margin: 0;
              padding: .375rem .75rem;
              font-size: .875rem;
            }
            .ocd-doc .ocd-copy {
              display: inline-flex;
              align-items: center;
              gap: .375rem;
              padding: .375rem .75rem;
              border: 0;
              border-left: 1px solid rgba(0, 0, 0, .12);
              background: none;
              color: inherit;
              font-size: .75rem;
              letter-spacing: .03em;
              text-transform: uppercase;
              opacity: .7;
              cursor: pointer;
            }
            .ocd-doc .ocd-copy:hover,
            .ocd-doc .ocd-copy:focus-visible {
              opacity: 1;
            }
            .ocd-doc pre {
              margin: 0;
              padding: .75rem 1rem;
              font-size: .8125rem;
              white-space: pre-wrap;
              overflow-wrap: anywhere;
            }
            .ocd-doc table {
              width: 100%;
              margin: .5rem 0 1rem;
              border-collapse: collapse;
              table-layout: fixed;
            }
            .ocd-doc .ocd-name-desc th:first-child {
              width: 30%;
            }
            .ocd-doc .ocd-constants th:nth-child(1) {
              width: 25%;
            }
            .ocd-doc .ocd-constants th:nth-child(2) {
              width: 15%;
            }
            .ocd-doc .ocd-constants th:nth-child(3) {
              width: 20%;
            }
            .ocd-doc th,
            .ocd-doc td {
              padding: .375rem .5rem;
              border: 1px solid rgba(0, 0, 0, .15);
              text-align: left;
              vertical-align: top;
              overflow-wrap: anywhere;
            }
            .ocd-doc td code {
              white-space: normal;
              overflow-wrap: anywhere;
            }
            .ocd-doc th {
              background: rgba(0, 0, 0, .04);
            }
            .ocd-doc td p {
              margin: 0;
            }
            .ocd-doc td p + p {
              margin-top: .5rem;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region documentation (
        name: DOCUMENTATION
        title: &P2_PACKAGE_NAME.
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                return ocd.ocd_apex_util.package_html(:P2_PACKAGE_NAME);
                ```
            pageItemsToSubmit: P2_PACKAGE_NAME
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region json-source (
        name: JSON_SOURCE
        title: JSON Source
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    v_content clob;
                begin
                    select
                        '<pre style="white-space:pre-wrap;font-family:monospace;">'
                        || apex_escape.html(json_serialize(pkg_data pretty))
                        || '</pre>'
                    into v_content
                    from ocd.ocd_apex_package_docs
                    where object_name = :P2_PACKAGE_NAME;

                    return v_content;
                end;
                ```
            pageItemsToSubmit: P2_PACKAGE_NAME
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    pageItem P2_PACKAGE_NAME (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button back-top (
        buttonName: BACK_TOP
        label: Back
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-chevron-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )

    process validate-package_1 (
        name: VALIDATE_PACKAGE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_cnt PLS_INTEGER;
                BEGIN
                    SELECT COUNT(*) INTO l_cnt
                    FROM ocd_apex_package_docs
                    WHERE object_name = :P2_PACKAGE_NAME;

                    IF l_cnt = 0 THEN
                        apex_util.redirect_url(
                            apex_page.get_url(
                                p_page   => 3,
                                p_items  => 'P3_PACKAGE_NAME',
                                p_values => :P2_PACKAGE_NAME));
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13562946435667126
        }
    )

)
