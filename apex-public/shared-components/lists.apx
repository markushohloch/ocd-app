list navigation-bar (
    name: Navigation Bar

    entry sign-in (
        label: Sign In
        icon {
            imageIconCssClasses: fa-sign-in
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: LOGIN
            }
        }
        serverSideCondition {
            type: userIsPublicUser
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            -- Home, the schema settings for signed in users and all packages
            -- of the selected schemas below their schema, the current page is highlighted.
            -- A schema links to the package browser filtered by this schema.
            select lvl, label, target, is_current, image
              from (
                select 1 as lvl,
                       'Home' as label,
                       apex_page.get_url(p_page => 1, p_clear_cache => 1) as target,
                       case when :APP_PAGE_ID = 1 and :P1_SCHEMA_NAME is null then 'YES' else 'NO' end as is_current,
                       'fa-home' as image,
                       0 as sort_group,
                       null as schema_name,
                       0 as sort_order
                  from dual
                union all
                select 1,
                       'Schemas',
                       apex_page.get_url(p_page => 4),
                       case when :APP_PAGE_ID = 4 then 'YES' else 'NO' end,
                       'fa-database',
                       1,
                       null,
                       0
                  from dual
                 where :APP_USER <> 'nobody'
                union all
                select 1,
                       schema_name,
                       apex_page.get_url(
                         p_page        => 1,
                         p_clear_cache => 1,
                         p_items       => 'P1_SCHEMA_NAME',
                         p_values      => schema_name),
                       case when :APP_PAGE_ID = 1 and schema_name = :P1_SCHEMA_NAME then 'YES' else 'NO' end,
                       'fa-folder-o',
                       2,
                       schema_name,
                       0
                  from ocd_apex_schema
                union all
                select 2,
                       p.column_value,
                       apex_page.get_url(
                         p_page   => 2,
                         p_items  => 'P2_SCHEMA_NAME,P2_PACKAGE_NAME',
                         p_values => s.schema_name || ',' || p.column_value),
                       case when :APP_PAGE_ID = 2
                             and s.schema_name = :P2_SCHEMA_NAME
                             and p.column_value = :P2_PACKAGE_NAME
                            then 'YES' else 'NO' end,
                       'fa-cube',
                       2,
                       s.schema_name,
                       1
                  from ocd_apex_schema s,
                       table(ocd_apex_util.package_names(s.schema_name)) p
              )
             order by sort_group, schema_name, sort_order, label
            ```
    }
)
